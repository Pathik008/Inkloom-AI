# ==============================================================================
# INKLOOM AI — ENVIRONMENT CONFIGURATION EXAMPLE
# Copy this file to `.env` in root and/or `backend/.env` before starting services.
# Never commit real API keys or production secrets to version control.
# ==============================================================================

# --- Application Settings ---
APP_NAME="Inkloom AI"
APP_ENV="development"
APP_VERSION="0.1.0"
DEBUG=true
API_V1_STR="/api/v1"

# --- Security & Authentication ---
# REQUIRED: Generate a 64-character random secret before running the application:
# Linux/macOS: openssl rand -hex 32
# Windows PowerShell: -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Max 256) })
# Python: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="REPLACE_WITH_A_SECURE_RANDOM_SECRET_KEY_MINIMUM_32_CHARACTERS"
JWT_ISSUER="inkloom-ai-api"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM="HS256"
AUTH_RATE_LIMIT_MAX_ATTEMPTS=15
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# --- CORS Configuration ---
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# --- PostgreSQL + pgvector Configuration ---
POSTGRES_USER="inkloom_user"
POSTGRES_PASSWORD="inkloom_dev_password_change_me"
POSTGRES_DB="inkloom_db"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432

# Full SQLAlchemy Database URL (PostgreSQL 16 with pgvector; Primary Production Database)
DATABASE_URL="postgresql+psycopg://inkloom_user:inkloom_dev_password_change_me@localhost:5432/inkloom_db"

# Opt-in SQLite fallback (FOR OFFLINE LOCAL DEVELOPMENT ONLY). Defaults to false.
ALLOW_SQLITE_DEV_FALLBACK=false
SQLITE_FALLBACK_URL="sqlite:///./inkloom_dev.db"

# --- AI & RAG Configuration (Phase 6+) ---
LLM_PROVIDER="openai_compatible"
LLM_API_KEY=""
LLM_MODEL_NAME="gpt-4o-mini"
EMBEDDING_MODEL_NAME="BAAI/bge-large-en-v1.5"
EMBEDDING_DIMENSION=1024
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_TOP_K=8
RAG_SIMILARITY_THRESHOLD=0.72

# --- Ingress & Proxy Settings ---
TRUSTED_PROXIES="127.0.0.1,::1"

# --- Storage Configuration ---
UPLOAD_STORAGE_DIR="storage/uploads"

# --- Demo & Judge Seeding (Optional) ---
# To seed demo data in development: SEED_DEMO_DATA=true
# In production/staging, safety gates require BOTH ALLOW_DEMO_SEED=true AND a unique non-default DEMO_ADMIN_PASSWORD:
SEED_DEMO_DATA=false
ALLOW_DEMO_SEED=false
DEMO_ADMIN_PASSWORD="REPLACE_WITH_UNIQUE_DEMO_PASSWORD_MIN_8_CHARS"

# --- Frontend Configuration ---
VITE_API_BASE_URL="http://localhost:8000"
