# ==============================================================================
# INKLOOM AI — ROOT GITIGNORE CONFIGURATION
# Comprehensive rules for Python, Node/Frontend, Databases, Logs & Secrets
# ==============================================================================

# --- Python Virtual Environments ---
.venv/
.venv*/
venv/
venv*/
ENV/
env/
env*/
backend/.venv*/
backend/venv*/

# --- Python & Pytest Caches ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.pytest_cache/
backend/.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Node & Frontend Build Outputs ---
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tsbuildinfo

# --- Local Databases, Dumps & Storage Volumes ---
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
*.sql.gz
*.dump
dumps/
uploads/
backend/uploads/
pgdata/
inkloom_pgdata/
inkloom_prod_pgdata/

# --- Secrets, Credentials & Certificates ---
*.pem
*.key
*.crt
*.cert
*.p12
*.pfx
*.csr
id_rsa*
*.pub.key
*.keystore
credentials.json
secrets.json

# --- Real Environment Files (NEVER COMMIT ACTUAL SECRETS) ---
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*

# Explicitly exempt ONLY safe example/template environment files
!.env.example
!.env.production.example
!backend/.env.example
!frontend/.env.example

# --- IDE, Editor & OS Artifacts ---
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# --- Logs & Runtime Output ---
*.log
logs/
backend/logs/
